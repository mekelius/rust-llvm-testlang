// RUN: %testc < %s | clang-22 -x ir - -o %t
// RUN: %t | filecheck %s

main() {
    println_int(-(5*4));     // CHECK-NEXT: -20
    println_int(-(-5--4));   // CHECK-NEXT:   1
    println_int(-(5*4));     // CHECK-NEXT: -20
    println_int(-(5*4));     // CHECK-NEXT: -20
    println_int(-(5*4));     // CHECK-NEXT: -20
    println_int(-(5*4));     // CHECK-NEXT: -20
    println_int(-(5*4));     // CHECK-NEXT: -20
    println_int(-(5*4));     // CHECK-NEXT: -20
}