// RUN: %parse < %s

hmm(x) {
    switch x {
        case 1:
            print("one\n");
        case 2:
            print("two\n");
            break;
        case 69:
            print("nice\n");
            break;
        default:
            print("something else\n");
    }
}

main() {
    hmm(1);                             
                                        
    hmm(2);                             
    hmm(69);                            
}
