// RUN: %testc < %s | clang-22 -x ir - -o %t
// RUN: %t | filecheck %s

hmm(x) {
    switch x {
        case 1:
            print("one\n");
            break;
        case 2:
            print("two\n");
            break;
        case 69:
            print("nice\n");
            break;
        default:
            print("something else\n");
    }
}

main() {
    hmm(99);                            // CHECK-NEXT: something else
    hmm(2);                             // CHECK-NEXT: two
    hmm(222);                           // CHECK-NEXT: something else
    hmm(1);                             // CHECK-NEXT: one
    hmm(69);                            // CHECK-NEXT: nice
}