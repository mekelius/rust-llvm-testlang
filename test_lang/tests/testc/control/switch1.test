// RUN: %testc < %s | clang-22 -x ir - -o %t
// RUN: %t | filecheck %s

function hmm(x) {
    switch x {
        case 1:
            print("one\n");
            break;
        case 2:
            print("two\n");
            break;
        case 69:
            print("nice\n");
            break;
    }
}

function main() {
    hmm(2);                             // CHECK-NEXT: two
    hmm(1);                             // CHECK-NEXT: one
    hmm(69);                            // CHECK-NEXT: nice
}