// RUN: %testc < %s | clang-22 -x ir - -o %t
// RUN: %t | filecheck %s

hmm(x) {
    print("before\n");          // CHECK-NEXT: before
    switch x {
        case 1:
            print("one");
            break;
        case 2:
            print("two");
            break;
        case 69:
            print("nice");
            break;
    }
    print("after\n");           // CHECK-NEXT: after
}

main() {
    hmm(32);
}