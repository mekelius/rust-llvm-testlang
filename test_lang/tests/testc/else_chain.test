// RUN: %testc < %s | clang-22 -x ir - -o %t
// RUN: %t | filecheck %s

function test(x) {
    if (x == 1) {
        print("a");
    } else if (x == 2) {
        print("b");
    } else {
        print("c");
    }
}

function main() {
    test(2);               // CHECK: b
    test(1);               // CHECK: a
    test(3);               // CHECK: c
    test(4);               // CHECK: c
}